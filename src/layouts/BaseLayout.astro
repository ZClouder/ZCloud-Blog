---
import '../styles/global.css';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '流雲の宝藏 — 一个记录技术与生活的个人博客' } = Astro.props;
const siteTitle = '流雲の宝藏';
const pageTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const theme = stored ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    </script>
    <noscript>
      <style>
        /* 入场效果全靠 JS 加 is-visible，禁用 JS 时不能把正文留成透明的 */
        .reveal,
        .stagger > * {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <Search />
    <script is:inline>
      // 相对时间：构建时渲染的是旧值，这里按真实当前时间刷新
      (function () {
        const els = document.querySelectorAll('time[data-relative]');
        if (!els.length) return;
        const now = Date.now();
        els.forEach((el) => {
          const iso = el.getAttribute('datetime');
          if (!iso) return;
          const days = Math.floor((now - new Date(iso + 'T00:00:00').valueOf()) / 86400000);
          let text;
          if (days < 0) text = '尚未到来';
          else if (days === 0) text = '今天';
          else if (days === 1) text = '昨天';
          else if (days < 30) text = days + ' 天前';
          else if (days < 365) text = Math.floor(days / 30) + ' 个月前';
          else text = Math.floor(days / 365) + ' 年前';
          el.textContent = text;
        });
      })();
    </script>
    <script is:inline>
      // 滚动入场：元素进入视口后淡入上移（.stagger 的容器只负责触发子元素错峰）
      (function () {
        const els = document.querySelectorAll('.reveal, .stagger');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import Stats from '../components/Stats.astro';
import RecentList from '../components/RecentList.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const RECENT_LIMIT = 5;
const recent = posts.slice(0, RECENT_LIMIT);
---

<BaseLayout title="流雲の宝藏">
  <Header transparent />
  <Hero />
  <main id="content" class="mx-auto max-w-3xl space-y-6 px-6 pb-6 pt-16 sm:pt-20">
    <section class="card reveal">
      <Stats posts={posts} />
    </section>

    <section class="card reveal">
      <div class="flex items-baseline justify-between">
        <h2 class="font-heading text-xl font-bold" style="color: var(--color-text);">近期笔墨</h2>
        <a
          href="/posts"
          class="font-mono text-xs transition-opacity hover:opacity-70"
          style="color: var(--color-text-muted);"
        >
          全部文章 →
        </a>
      </div>
      <div class="mt-2">
        <RecentList posts={recent} />
      </div>
    </section>

    {/* 文章超过 RECENT_LIMIT 篇时才单独列出全部，避免与「近期笔墨」重复 */}
    {posts.length > RECENT_LIMIT && (
      <section class="card reveal">
        <h2 class="font-heading text-2xl font-bold" style="color: var(--color-text);">全部文章</h2>
        <div class="mt-6 space-y-3">
          {posts.map((post) => (
            <PostCard
              href={`/posts/${post.id}/`}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
            />
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>

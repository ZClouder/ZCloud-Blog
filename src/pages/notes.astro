---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WritingTabs from '../components/WritingTabs.astro';
import { getCollection, render } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const entries = await Promise.all(
  notes.map(async (note) => {
    const { Content } = await render(note);
    return { note, Content };
  })
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="随记" description="不成篇的片段：一句话、一张照片、某个黄昏。">
  <Header />
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-heading text-3xl font-bold" style="color: var(--color-text);">随记</h1>
    <p class="mt-3 text-sm leading-relaxed" style="color: var(--color-text-muted);">
      不成篇的片段：一句话、一张照片、某个黄昏。
    </p>

    <div class="mt-8">
      <WritingTabs active="notes" />
    </div>

    {entries.length === 0 ? (
      <p class="mt-10 text-sm" style="color: var(--color-text-muted);">还没有随记。</p>
    ) : (
      <ol class="note-timeline mt-10">
        {entries.map(({ note, Content }) => (
          <li class="note-item reveal" id={`note-${note.id}`}>
            <time
              class="font-mono text-xs tracking-wider"
              style="color: var(--color-text-muted);"
              datetime={note.data.date.toISOString().slice(0, 10)}
            >
              {formatDate(note.data.date)}
            </time>

            <div class="note-text mt-3">
              <Content />
            </div>

            {note.data.image && (
              <figure class="note-figure">
                <img
                  src={note.data.image}
                  alt={note.data.imageAlt ?? ''}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}

            {note.data.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-3">
                {note.data.tags.map((tag) => (
                  <span class="font-mono text-[11px]" style="color: var(--color-text-muted);">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </li>
        ))}
      </ol>
    )}
  </main>
  <Footer />
</BaseLayout>

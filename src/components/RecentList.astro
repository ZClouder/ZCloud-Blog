---
import { relativeTime, isoDate } from '../utils/time';

interface Props {
  posts: { id: string; data: { title: string; pubDate: Date; tags: string[] } }[];
}

const { posts } = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');
const shortDate = (d: Date) =>
  `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())}`;
---

<ul class="divide-y" style="border-color: var(--color-border);">
  {posts.map((post, i) => (
    <li>
      <a href={`/posts/${post.id}/`} class="recent-item group flex items-baseline gap-4 py-4">
        <span class="recent-index font-mono text-sm" style="color: var(--color-text-muted);">
          {pad(i + 1)}
        </span>
        <span class="min-w-0 flex-1">
          <span class="recent-title block truncate text-base font-medium" style="color: var(--color-text);">
            {post.data.title}
          </span>
          {post.data.tags.length > 0 && (
            <span class="mt-1 block font-mono text-xs" style="color: var(--color-text-muted);">
              {post.data.tags.map((t) => `#${t}`).join(' ')}
            </span>
          )}
        </span>
        <span class="flex shrink-0 flex-col items-end gap-0.5 font-mono text-xs" style="color: var(--color-text-muted);">
          <time datetime={isoDate(post.data.pubDate)} data-relative>{relativeTime(post.data.pubDate)}</time>
          <span class="opacity-60">{shortDate(post.data.pubDate)}</span>
        </span>
      </a>
    </li>
  ))}
</ul>

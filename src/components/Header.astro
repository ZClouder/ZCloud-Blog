---
import { getCollection } from 'astro:content';
import { relativeTime } from '../utils/time';
import { markdownPreview } from '../utils/text';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const nav = [
  { href: '/', label: '首页' },
  { href: '/posts', label: '文章', panel: 'posts' },
  { href: '/notes', label: '随记', panel: 'notes' },
  { href: '/projects', label: '项目' },
  { href: '/friends', label: '友邻' },
  { href: '/about', label: '关于' },
];

// 去掉尾斜杠再比较，否则 /notes/ 与 /notes 不相等，导航高亮失效
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

// 悬浮面板只给两个内容入口用：这里没有 innei 那种「分类 / 专栏」子层级可展开，
// 能诚实地展示出来的就是「最近写了什么」。
const recentPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const recentNotes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<header
  id="site-header"
  class="fixed top-0 z-50 w-full border-b transition-all duration-300"
  data-transparent={transparent ? "true" : undefined}
  data-pagefind-ignore
  style="border-color: var(--color-border); background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);"
>
  <div class="mx-auto flex max-w-3xl items-center gap-3 px-4 py-3 sm:gap-4 sm:px-6 sm:py-4">
    <a
      href="/"
      class="site-title font-heading shrink-0 text-sm font-bold tracking-wide sm:text-lg"
      style="color: var(--color-text);"
    >
      流雲の宝藏
    </a>

    <nav class="nav-scroll no-scrollbar flex min-w-0 flex-1 overflow-x-auto sm:justify-center sm:overflow-visible">
      <div class="nav-seg">
        {nav.map((item) =>
          item.panel ? (
            <div class="nav-item-wrap" data-nav-wrap>
              <a
                href={item.href}
                class="nav-seg-item"
                aria-current={currentPath === item.href ? 'page' : undefined}
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls={`nav-panel-${item.panel}`}
              >
                {item.label}
              </a>

              <div
                class="nav-panel"
                id={`nav-panel-${item.panel}`}
                data-nav-panel
                role="region"
                aria-label={`最近${item.label}`}
              >
                <div class="nav-panel-inner">
                  <div class="flex items-baseline justify-between gap-4 px-3.5 pb-1.5 pt-3">
                    <span class="font-mono text-[11px] tracking-wide" style="color: var(--color-text-muted);">
                      最近{item.label}
                    </span>
                    <a href={item.href} class="font-mono text-[11px]" style="color: var(--color-accent);">
                      全部 →
                    </a>
                  </div>

                  {item.panel === 'posts' ? (
                    recentPosts.length > 0 ? (
                      <ul class="p-1.5 pt-0">
                        {recentPosts.map((post) => (
                          <li>
                            <a href={`/posts/${post.id}/`} class="nav-panel-item">
                              <span class="block truncate text-sm" style="color: var(--color-text);">
                                {post.data.title}
                              </span>
                              <span class="mt-0.5 block font-mono text-[11px]" style="color: var(--color-text-muted);">
                                {relativeTime(post.data.pubDate)}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="px-3.5 pb-3 text-xs" style="color: var(--color-text-muted);">还没有文章。</p>
                    )
                  ) : recentNotes.length > 0 ? (
                    <ul class="p-1.5 pt-0">
                      {recentNotes.map((note) => (
                        <li>
                          <a href={`/notes/#note-${note.id}`} class="nav-panel-item">
                            <span class="block truncate text-sm" style="color: var(--color-text);">
                              {markdownPreview(note.body, 18)}
                            </span>
                            <span class="mt-0.5 block font-mono text-[11px]" style="color: var(--color-text-muted);">
                              {relativeTime(note.data.date)}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="px-3.5 pb-3 text-xs" style="color: var(--color-text-muted);">还没有随记。</p>
                  )}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="nav-seg-item"
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          )
        )}
      </div>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <button
        id="search-open"
        type="button"
        aria-label="搜索"
        class="header-btn flex h-8 w-8 items-center justify-center rounded-full border transition-colors hover:opacity-70"
        style="border-color: var(--color-border); color: var(--color-text);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>
      <button
        id="theme-toggle"
        type="button"
        aria-label="切换主题"
        class="header-btn flex h-8 w-8 items-center justify-center rounded-full border transition-colors hover:opacity-70"
        style="border-color: var(--color-border); color: var(--color-text);"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  #site-header[data-transparent="true"] {
    background-color: transparent !important;
    border-color: transparent !important;
    backdrop-filter: none;
  }

  #site-header:not([data-transparent="true"]) {
    backdrop-filter: blur(12px);
  }

  /* 首页透明态：标题与圆形按钮转白 */
  #site-header[data-transparent="true"] .site-title {
    color: #fff !important;
  }

  #site-header[data-transparent="true"] .header-btn {
    color: #fff !important;
    border-color: rgb(255 255 255 / 0.35) !important;
  }

  /* 分段控件玻璃质感变体，压在 Hero 大图上 */
  #site-header[data-transparent="true"] .nav-seg {
    background-color: rgb(255 255 255 / 0.14);
    border-color: rgb(255 255 255 / 0.22);
    backdrop-filter: blur(10px);
  }

  #site-header[data-transparent="true"] .nav-seg-item {
    color: rgb(255 255 255 / 0.78);
  }

  #site-header[data-transparent="true"] .nav-seg-item:hover {
    color: #fff;
    background-color: rgb(255 255 255 / 0.16);
  }

  #site-header[data-transparent="true"] .nav-seg-item[aria-current="page"] {
    background-color: rgb(255 255 255 / 0.24);
    color: #fff;
    box-shadow: none;
  }

  #site-header[data-transparent="true"] .nav-seg-item[aria-current="page"]:hover {
    background-color: rgb(255 255 255 / 0.3);
  }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    const sun = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');

    function syncIcons() {
      const isDark = document.documentElement.dataset.theme === 'dark';
      sun?.classList.toggle('hidden', isDark);
      moon?.classList.toggle('hidden', !isDark);
    }
    syncIcons();

    btn?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      syncIcons();
    });

    // Transparent header: observe hero visibility
    const header = document.getElementById('site-header');
    const hero = document.getElementById('hero');
    if (header && hero && header.dataset.transparent === 'true') {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            header.dataset.transparent = 'true';
          } else {
            header.dataset.transparent = 'false';
          }
        },
        { threshold: 0, rootMargin: '-64px 0px 0px 0px' }
      );
      observer.observe(hero);
    }

    // 悬浮面板：视觉由 CSS 的 :hover / :focus-within 负责，
    // 这里只同步 aria-expanded，并让 Esc 能收起（鼠标仍停在上面时也管用）。
    document.querySelectorAll('[data-nav-wrap]').forEach((wrap) => {
      const link = wrap.querySelector('a[aria-haspopup]');
      const panel = wrap.querySelector('[data-nav-panel]');
      if (!link || !panel) return;

      const setOpen = (open) => link.setAttribute('aria-expanded', open ? 'true' : 'false');

      wrap.addEventListener('mouseenter', () => {
        panel.classList.remove('is-hidden');
        setOpen(true);
      });
      wrap.addEventListener('mouseleave', () => {
        panel.classList.remove('is-hidden');
        setOpen(false);
      });
      wrap.addEventListener('focusin', () => setOpen(true));
      wrap.addEventListener('focusout', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      document.querySelectorAll('[data-nav-panel]').forEach((panel) => panel.classList.add('is-hidden'));
      document.querySelectorAll('[data-nav-wrap] a[aria-haspopup]').forEach((link) =>
        link.setAttribute('aria-expanded', 'false')
      );
      if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
    });
  })();
</script>

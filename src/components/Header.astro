---
interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
const nav = [
  { href: '/', label: '首页' },
  { href: '/posts', label: '文章' },
  { href: '/notes', label: '随记' },
  { href: '/projects', label: '项目' },
  { href: '/friends', label: '友邻' },
  { href: '/about', label: '关于' },
];
// 去掉尾斜杠再比较，否则 /notes/ 与 /notes 不相等，导航高亮失效
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header
  id="site-header"
  class="fixed top-0 z-50 w-full border-b transition-all duration-300"
  data-transparent={transparent ? "true" : undefined}
  data-pagefind-ignore
  style="border-color: var(--color-border); background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);"
>
  <div class="mx-auto flex max-w-3xl items-center gap-3 px-4 py-3 sm:gap-4 sm:px-6 sm:py-4">
    <a
      href="/"
      class="site-title font-heading shrink-0 text-sm font-bold tracking-wide sm:text-lg"
      style="color: var(--color-text);"
    >
      流雲の宝藏
    </a>

    <nav class="nav-scroll no-scrollbar flex min-w-0 flex-1 overflow-x-auto sm:justify-center">
      <div class="nav-seg">
        {nav.map((item) => (
          <a
            href={item.href}
            class="nav-seg-item"
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <button
        id="search-open"
        type="button"
        aria-label="搜索"
        class="header-btn flex h-8 w-8 items-center justify-center rounded-full border transition-colors hover:opacity-70"
        style="border-color: var(--color-border); color: var(--color-text);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>
      <button
        id="theme-toggle"
        type="button"
        aria-label="切换主题"
        class="header-btn flex h-8 w-8 items-center justify-center rounded-full border transition-colors hover:opacity-70"
        style="border-color: var(--color-border); color: var(--color-text);"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  #site-header[data-transparent="true"] {
    background-color: transparent !important;
    border-color: transparent !important;
    backdrop-filter: none;
  }

  #site-header:not([data-transparent="true"]) {
    backdrop-filter: blur(12px);
  }

  /* 首页透明态：标题与圆形按钮转白 */
  #site-header[data-transparent="true"] .site-title {
    color: #fff !important;
  }

  #site-header[data-transparent="true"] .header-btn {
    color: #fff !important;
    border-color: rgb(255 255 255 / 0.35) !important;
  }

  /* 分段控件玻璃质感变体，压在 Hero 大图上 */
  #site-header[data-transparent="true"] .nav-seg {
    background-color: rgb(255 255 255 / 0.14);
    border-color: rgb(255 255 255 / 0.22);
    backdrop-filter: blur(10px);
  }

  #site-header[data-transparent="true"] .nav-seg-item {
    color: rgb(255 255 255 / 0.78);
  }

  #site-header[data-transparent="true"] .nav-seg-item:hover {
    color: #fff;
  }

  #site-header[data-transparent="true"] .nav-seg-item[aria-current="page"] {
    background-color: rgb(255 255 255 / 0.24);
    color: #fff;
    box-shadow: none;
  }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    const sun = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');

    function syncIcons() {
      const isDark = document.documentElement.dataset.theme === 'dark';
      sun?.classList.toggle('hidden', isDark);
      moon?.classList.toggle('hidden', !isDark);
    }
    syncIcons();

    btn?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      syncIcons();
    });

    // Transparent header: observe hero visibility
    const header = document.getElementById('site-header');
    const hero = document.getElementById('hero');
    if (header && hero && header.dataset.transparent === 'true') {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            header.dataset.transparent = 'true';
          } else {
            header.dataset.transparent = 'false';
          }
        },
        { threshold: 0, rootMargin: '-64px 0px 0px 0px' }
      );
      observer.observe(hero);
    }
  })();
</script>

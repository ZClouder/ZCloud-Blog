---
import { relativeTime, isoDate } from '../utils/time';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

const { href, title, description, pubDate, tags } = Astro.props;
const absolute = pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<a
  href={href}
  class="post-card group block rounded-lg p-5"
  style="background-color: var(--color-surface);"
>
  <div class="flex flex-wrap items-center gap-x-2 font-mono text-xs tracking-wide" style="color: var(--color-text-muted);">
    <time datetime={isoDate(pubDate)} data-relative>{relativeTime(pubDate)}</time>
    <span class="opacity-40">·</span>
    <span>{absolute}</span>
  </div>

  <h2 class="font-heading mt-2 text-2xl font-bold transition-colors" style="color: var(--color-text);">
    <span class="bg-[length:0%_1px] bg-left-bottom bg-no-repeat transition-[background-size] duration-300 group-hover:bg-[length:100%_1px]" style={`background-image: linear-gradient(var(--color-accent), var(--color-accent))`}>
      {title}
    </span>
  </h2>

  <p class="mt-2 line-clamp-2 text-sm leading-relaxed" style="color: var(--color-text-muted);">{description}</p>

  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span
          class="rounded-full px-2.5 py-0.5 text-xs"
          style="background-color: var(--color-accent-soft); color: var(--color-accent);"
        >
          #{tag}
        </span>
      ))}
    </div>
  )}
</a>

<style>
  .post-card {
    border: 1px solid transparent;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .post-card:hover {
    border-color: var(--color-border);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.06);
  }

  [data-theme="dark"] .post-card:hover {
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.32);
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card { transition: none; }
    .post-card:hover { transform: none; }
  }
</style>

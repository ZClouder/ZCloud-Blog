---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 1 && (
  <nav id="toc" class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
    <p class="font-mono text-xs tracking-[0.2em]" style="color: var(--color-text-muted);">目录</p>
    <ul class="mt-3 space-y-1.5">
      {items.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            data-toc-link
            class={`toc-link block border-l-2 py-0.5 text-sm leading-snug transition-colors ${h.depth === 3 ? 'pl-6' : 'pl-3'}`}
            style="border-color: var(--color-border); color: var(--color-text-muted);"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc-link:hover {
    color: var(--color-text);
  }
  .toc-link.is-active {
    border-color: var(--color-accent) !important;
    color: var(--color-accent) !important;
  }
</style>

<script is:inline>
  (function () {
    const links = Array.from(document.querySelectorAll('[data-toc-link]'));
    if (!links.length) return;

    const targets = links
      .map((a) => {
        const id = decodeURIComponent(a.getAttribute('href').slice(1));
        const el = document.getElementById(id);
        return el ? { el, link: a } : null;
      })
      .filter(Boolean);

    if (!targets.length) return;

    let ticking = false;

    function update() {
      ticking = false;
      const offset = 100;
      let current = targets[0];
      for (const t of targets) {
        if (t.el.getBoundingClientRect().top <= offset) current = t;
      }
      // 滚动到页面底部时高亮最后一项
      if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4) {
        current = targets[targets.length - 1];
      }
      targets.forEach((t) => t.link.classList.toggle('is-active', t === current));
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  })();
</script>
